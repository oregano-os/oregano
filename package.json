{
  "name": "oregano",
  "private": true,
  "version": "0.5.14",
  "packageManager": "pnpm@11.16.0+sha512.b767e9a98fc87aec0f42daefcd0e84941c2cdb45d73c4e1e68860fb2bdfdbe032ab592105479e5e05c237f740c8a5ffdbbb52385797ddc2296745a1bbb883e8d",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "companyos": "node packages/cli/src/cli.mjs",
    "docs:generate": "node packages/cli/src/cli.mjs docs generate",
    "docs:check": "node packages/cli/src/cli.mjs docs check",
    "public:check": "node scripts/check-public-boundary.mjs",
    "validate:fixture": "node packages/cli/src/cli.mjs validate packages/testkit/fixtures/acme-casas",
    "validate:company": "node packages/cli/src/cli.mjs validate",
    "build:instance": "node packages/cli/src/cli.mjs build",
    "validate": "pnpm docs:check && pnpm validate:fixture",
    "typecheck": "tsc",
    "runner:typecheck": "pnpm --dir packages/runner-vercel typecheck",
    "runner:build": "pnpm --dir packages/runner-vercel build",
    "test": "node --experimental-strip-types --test packages/testkit/tests/*.test.ts packages/cli/tests/*.test.mjs packages/runner-vercel/src/lib/agent-handoff-tools.test.ts packages/runner-vercel/src/lib/slack-agent-experience.test.ts packages/runner-vercel/src/lib/company-records-*.test.ts packages/runner-vercel/src/lib/builder/*.test.ts",
    "builder:check": "pnpm --dir packages/builder-worker typecheck && node --experimental-strip-types --test packages/testkit/tests/agent-resolver.test.ts packages/testkit/tests/builder-*.test.ts packages/testkit/tests/repository-adapters.test.ts",
    "check": "pnpm public:check && pnpm validate && pnpm typecheck && pnpm runner:typecheck && pnpm builder:check && pnpm test",
    "test:database": "node scripts/test-database.mjs"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.70.0",
    "@agentclientprotocol/codex-acp": "1.6.2",
    "@agentclientprotocol/sdk": "1.4.0",
    "@neondatabase/serverless": "1.1.0",
    "@types/node": "^25.9.3",
    "pg": "8.23.0",
    "typescript": "7.0.1-rc",
    "vercel": "56.3.2",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
