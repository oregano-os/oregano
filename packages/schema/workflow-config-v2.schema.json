{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyos.org/schema/workflow-config-v2.schema.json",
  "title": "Literal workflow configuration",
  "type": "object",
  "required": [
    "schema_version",
    "id"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    }
  },
  "additionalProperties": {
    "$ref": "#/$defs/value"
  },
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    }
  }
}
