{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyos.org/schema/sprint-configuration-v1.schema.json",
  "title": "Sprint configuration declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "participants", "work_items", "calendar", "close", "submission", "effort", "rollover", "delivery"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "participants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "absence_policy"],
      "properties": {
        "projection": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "absence_policy": { "type": "string", "enum": ["exclude-approved", "include-all"] },
        "roster_group": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" }
      }
    },
    "work_items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "master_group", "ready_status", "closed_statuses"],
      "properties": {
        "projection": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "master_group": { "type": "string", "minLength": 1, "maxLength": 127 },
        "ready_status": { "type": "string", "minLength": 1, "maxLength": 127 },
        "closed_statuses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 127 }, "uniqueItems": true },
        "planning_group": { "type": "string", "minLength": 1, "maxLength": 127 },
        "planned_status": { "type": "string", "minLength": 1, "maxLength": 127 },
        "required_fields": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,126}$" } }
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "business_calendar_ref", "holiday_shift"],
      "properties": {
        "timezone": { "type": "string", "minLength": 1, "maxLength": 127 },
        "business_calendar_ref": { "type": "string", "minLength": 1, "maxLength": 127 },
        "holiday_shift": { "type": "string", "enum": ["previous-business-day", "next-business-day", "none"] }
      }
    },
    "close": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weekday", "reminder_time", "complete_by", "report_at"],
      "properties": {
        "weekday": { "type": "string", "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] },
        "reminder_time": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
        "complete_by": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
        "chase_time": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
        "report_at": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_line_rule", "after_report"],
      "properties": {
        "task_line_rule": { "type": "string", "enum": ["one-per-committed-task"] },
        "after_report": { "type": "string", "enum": ["provider-only", "next-report", "reject"] }
      }
    },
    "effort": { "type": "string", "enum": ["actual-hours", "planned-effort", "unavailable"] },
    "rollover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible"],
      "properties": {
        "eligible": { "type": "string", "enum": ["all-open", "selected-states"] },
        "states": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shared_thread", "channel_binding", "direct_binding"],
      "properties": {
        "shared_thread": { "type": "boolean" },
        "channel_binding": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "direct_binding": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" }
      }
    },
    "weekly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monday_handoff_trigger", "weekday_digest_trigger", "readiness_weekday"],
      "properties": {
        "monday_handoff_trigger": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "weekday_digest_trigger": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "readiness_weekday": { "type": "string", "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] }
      }
    },
    "model_task_profile": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,127}$" },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reminder", "chase", "close_report", "retro"],
      "properties": {
        "reminder": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}\\.md$" },
        "chase": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}\\.md$" },
        "close_report": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}\\.md$" },
        "retro": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}\\.md$" },
        "monday_handoff": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}\\.md$" },
        "weekday_digest": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}\\.md$" },
        "direct_question": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}\\.md$" }
      }
    }
  }
}
