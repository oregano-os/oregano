{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyos.dev/schemas/document-metadata-v1.json",
  "title": "CompanyOS canonical document metadata",
  "type": "object",
  "required": [
    "document_id",
    "title",
    "kind",
    "status",
    "authority",
    "language",
    "updated",
    "owners",
    "audience"
  ],
  "properties": {
    "document_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "type": "string" },
    "status": { "enum": ["draft", "approved", "building", "implemented", "superseded", "frozen"] },
    "authority": { "enum": ["canonical", "normative", "informative", "generated", "historical"] },
    "language": { "type": "string" },
    "updated": { "type": "string", "format": "date" },
    "owners": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "audience": { "type": "array", "minItems": 1, "items": { "enum": ["human", "agent"] } },
    "availability": { "enum": ["planned", "experimental", "stable"] },
    "migration_sources": { "type": "array", "items": { "type": "string" } },
    "relations": { "type": "object" }
  },
  "additionalProperties": true
}
