{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --dir packages/runner-vercel build",
  "outputDirectory": "packages/runner-vercel/.next",
  "crons": [
    {
      "path": "/api/builder/worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/records/reconcile",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/sprint/timers",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/sprint/intents",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/workflows/timers",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/workflows/steps",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/workflows/records",
      "schedule": "* * * * *"
    }
  ]
}
